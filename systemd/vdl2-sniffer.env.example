# Copy to ~/.config/vdl2-sniffer.env and edit. Extra options for
# vdl2-sniffer.service, split on spaces.
#
# Feed decoded frames (dumpvdl2-style JSON) to an aggregator or acarshub,
# under your station id:
#   VDL2_ARGS=--udp HOST:PORT --station-id XX-VDL2
# Several destinations (a local acarshub and an aggregator, say) go on one --udp:
#   VDL2_ARGS=--udp 127.0.0.1:5555 HOST:PORT --station-id XX-VDL2
#
# Fixed gain, frequency correction, antenna power:
#   VDL2_ARGS=--gain 40 --ppm 1 --bias-tee
VDL2_ARGS=
